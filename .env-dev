# Локальный dev-запуск модулей

LOGGING_LEVEL=INFO

# PLC (m0_plc)
TCP_HOST=0.0.0.0
TCP_PORT=4096
PLC_INTERVAL_SEC=10

# API (m1_api)
API_HOST=0.0.0.0
API_PORT=8000
DB_PATH=./excercise.db

# Camera (m2_camera)
WS_HOST=0.0.0.0
WS_PORT=1234
IMAGES_DIR=./backend_test
API_BASE_URL=http://localhost:8000
RECONNECT_DELAY_SEC=5

# MinIO (поднят в docker-compose.dev.yaml)
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=images

# RabbitMQ (поднят в docker-compose.dev.yaml)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_EXCHANGE=inference.in
RABBITMQ_ROUTING_KEY=inference.in
