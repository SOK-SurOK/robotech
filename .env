# Порты на хосте (внутри контейнеров порты фиксированы)
TCP_PORT=4096
WS_PORT=1234
API_PORT=8000
WEB_PORT=8080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# PLC
PLC_INTERVAL_SEC=10

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=images

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_EXCHANGE=inference.in
RABBITMQ_ROUTING_KEY=inference.in

# Логирование
LOGGING_LEVEL=INFO
TZ=Asia/Yekaterinburg

# Образы MinIO: канонические minio/minio и minio/mc могут быть недоступны
# в некоторых регионах (блокировка на стороне registry) — тогда bitnamilegacy/*
MINIO_IMAGE=bitnamilegacy/minio:latest
MC_IMAGE=bitnamilegacy/minio-client:latest
